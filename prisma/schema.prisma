generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String     @id @default(uuid())
  name       String
  email      String     @unique
  password   String     @default("xai@2026")
  role       String     // "SECURITY_LEAD" | "DEVELOPER" | "QA_ENGINEER" | "NIST_AUDITOR" | "ARCHITECT"
  avatar     String?
  department String     @default("Department of Computer Engineering, SITRC")
  createdAt  DateTime   @default(now())
  auditLogs  AuditLog[]
}

model AuditLog {
  id                String   @id @default(uuid())
  phase             String
  inputData         String
  aiPredictionLabel String
  aiProbability     Float
  xaiModality       String
  explanation       String
  userId            String?
  userName          String?
  userEmail         String?
  userRole          String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
}
