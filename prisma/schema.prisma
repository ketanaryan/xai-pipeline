generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AuditLog {
  id                String   @id @default(uuid())
  phase             String
  inputData         String
  aiPredictionLabel String
  aiProbability     Float
  xaiModality       String
  explanation       String
  createdAt         DateTime @default(now())
}
